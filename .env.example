PORT=3001
# Airtable (obligatoire pour enregistrer les devis) — https://airtable.com/create/tokens
# AIRTABLE_BASE = ID de la base (appXXXXXXXXXXXXXX)
# AIRTABLE_TABLE_DEVIS = nom ou ID de la table (ex. tblXXXXXXXXXXXXXX)
AIRTABLE_KEY=patxxxxxxxxxxxxxxxx
AIRTABLE_BASE=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_DEVIS=tblXXXXXXXXXXXXXX
# Table Avance immédiate (si vous utilisez les routes URSSAF)
AIRTABLE_TABLE_AVANCE=tblYYYYYYYYYYYYYY

# Optionnel : pour lister les demandes en GET /api/devis (header Authorization: Bearer VOTRE_TOKEN)
ADMIN_TOKEN=pbe,f>%wp=g+aLE"gd(L
# Resend : clé API (https://resend.com) + email de destination
RESEND_API_KEY=re_xxxxxxxxxxxxx
NOTIFY_EMAIL=ton@email.com
